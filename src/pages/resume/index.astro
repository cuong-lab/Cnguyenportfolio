---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, useTranslations, localize as L } from '../../i18n/utils';
import { about } from '../../data';
import { getResumeExperiences, getResumePage } from '../../sanity/api.js';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const [experiences, resumeContent] = await Promise.all([
  getResumeExperiences(),
  getResumePage(),
]);
---

<BaseLayout
  title={L(about.meta.title, locale)}
  description={L(about.meta.description, locale)}
>
  <main class="resume-main-wrapper">
    <div class="resume-page-container">
      
      <!-- Bio & Profile Section -->
      <section id="about-me" class="section resume-bio-section reveal">
        <div class="bio-layout">
          <div class="bio-main-content">
            <p class="section-tag">{resumeContent.eyebrow || '[ VỀ TÔI ]'}</p>
            <h1 class="bio-title">{resumeContent.title}</h1>
            
            <div class="bio-paragraphs">
              {resumeContent.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            
            <!-- Strengths integrated naturally into layout (No floating box) -->
            <div class="strengths-block">
              <h3 class="strengths-heading">{t('about.strengths')}</h3>
              <ul class="strengths-list">
                {resumeContent.strengths.map((s) => (
                  <li><span>{s}</span></li>
                ))}
              </ul>
            </div>
          </div>

          <div class="bio-avatar-wrapper">
            {resumeContent.avatarUrl ? (
              <img src={resumeContent.avatarUrl} alt="Cường Nguyễn Avatar" class="bio-avatar-img" />
            ) : (
              <div class="bio-avatar-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
            )}
          </div>
        </div>
      </section>

      <div class="resume-two-column section">
        <!-- Experience Timeline Section (Left) -->
        <div class="resume-left-col">
          <section id="resume-experience" class="resume-experience-section reveal">
            <div class="section-heading">
              <p class="section-tag">[ KINH NGHIỆM ]</p>
              <h2>{resumeContent.experienceHeading}</h2>
            </div>
            <div class="resume-timeline">
              {experiences.map((exp) => (
                <article class="resume-timeline-item reveal-stagger">
                  <div class="timeline-marker"></div>
                  <div class="timeline-content">
                    <div class="timeline-header">
                      <h3 class="timeline-company">{exp.company}</h3>
                      <span class="timeline-date">{exp.timeframe}</span>
                    </div>
                    <h4 class="timeline-role">{exp.role}</h4>
                    
                    <p class="timeline-desc">{exp.description}</p>
                    
                    <div class="timeline-meta">
                      <div class="meta-group">
                        <strong>{t('resume.outcomes')}:</strong>
                        <p>{exp.outcomes}</p>
                      </div>
                      
                      <div class="meta-group tags">
                        <strong>{t('resume.skills')}:</strong>
                        <div class="resume-tags">
                          {exp.skills.map((tag) => (
                            <span class="tag">{tag}</span>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar Section (Right) -->
        <aside class="resume-sidebar reveal">
          <section class="sidebar-section">
            <div class="section-heading">
              <p class="section-tag">[ KỸ NĂNG ]</p>
              <h2 class="sidebar-heading">{resumeContent.skillsHeading}</h2>
            </div>
            <ul class="sidebar-list">
              {resumeContent.skills.map((skill) => (
                <li class="sidebar-item">
                  <span class="skill-name">{skill.name}</span>
                  <div class="skill-bars" aria-label={`Level ${skill.level} out of 5`}>
                    {[1, 2, 3, 4, 5].map((n) => (
                      <div class:list={['skill-bar-segment', { filled: n <= skill.level }]}></div>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </section>

          {resumeContent.languages && resumeContent.languages.length > 0 && (
            <section class="sidebar-section">
              <h2 class="sidebar-heading">{resumeContent.languagesHeading}</h2>
              <ul class="sidebar-list">
                {resumeContent.languages.map((lang) => (
                  <li class="sidebar-item">
                    <span class="skill-name">{lang.name}</span>
                    <div class="skill-bars" aria-label={`Level ${lang.level} out of 5`}>
                      {[1, 2, 3, 4, 5].map((n) => (
                        <div class:list={['skill-bar-segment', { filled: n <= lang.level }]}></div>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {resumeContent.hobbies && resumeContent.hobbies.length > 0 && (
            <section class="sidebar-section">
              <h2 class="sidebar-heading">{resumeContent.hobbiesHeading}</h2>
              <ul class="sidebar-list hobbies-list">
                {resumeContent.hobbies.map((hobby) => (
                  <li class="sidebar-item hobby-item">
                    <span class="skill-name">{hobby}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>
      
    </div>
  </main>
</BaseLayout>
