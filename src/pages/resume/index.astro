---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, useTranslations, localize as L } from '../../i18n/utils';
import { about } from '../../data';
import { getResumeExperiences } from '../../sanity/api.js';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const pad = (n: number) => String(n + 1).padStart(2, '0');
// Experience entries come from Sanity `resume_experience` (fallback: about.json).
// The About/Skills copy above isn't in the Sanity schema, so it stays in src/data.
const experiences = await getResumeExperiences();
---

<BaseLayout
  title={L(about.meta.title, locale)}
  description={L(about.meta.description, locale)}
  initFn="initResume"
>
  <main>
    <section id="about-me" class="section about reveal">
      <div class="section-heading">
        <p class="eyebrow">{L(about.eyebrow, locale)}</p>
        <h2>{L(about.title, locale)}</h2>
      </div>
      <div class="about-grid">
        <div class="about-copy">
          {about.paragraphs.map((p) => (
            <p>{L(p, locale)}</p>
          ))}
        </div>
        <div class="about-card">
          <h3>{t('about.strengths')}</h3>
          <ul>
            {about.strengths.map((s) => (
              <li>{L(s, locale)}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section skills-section reveal">
      <div class="section-heading">
        <p class="eyebrow">{L(about.skillsEyebrow, locale)}</p>
        <h2>{L(about.skillsHeading, locale)}</h2>
      </div>
      <div class="skills-pills reveal-stagger">
        {about.skills.map((skill) => (
          <span class="skill-pill">{skill}</span>
        ))}
      </div>
    </section>

    <section id="resume-experience" class="section resume-section reveal">
      <div class="section-heading">
        <p class="eyebrow">{L(about.experienceEyebrow, locale)}</p>
        <h2>{L(about.experienceHeading, locale)}</h2>
      </div>
      <div class="resume-pin-section" id="resume-pin-section">
        <div class="resume-pin-inner">
          {experiences.map((exp, i) => (
            <article class:list={['resume-entry', { active: i === 0 }]} data-index={i}>
              <div class="resume-entry-header">
                <p class="resume-entry-eyebrow">{t('resume.experience')} {pad(i)}</p>
                <h3 class="resume-entry-company">{exp.company}</h3>
              </div>
              <div class="resume-entry-visual">
                <div class="resume-entry-visual-scale">
                  <div class="resume-entry-visual-clip"></div>
                </div>
              </div>
              <div class="resume-entry-meta">
                <div class="resume-field-block">
                  <p class="resume-field-label">{t('resume.role')}</p>
                  <p class="resume-field-value">{exp.role}</p>
                </div>
                <div class="resume-field-block">
                  <p class="resume-field-label">{t('resume.skills')}</p>
                  <div class="resume-entry-tags">
                    {exp.skills.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </div>
                <div class="resume-field-block">
                  <p class="resume-field-label">{t('resume.outcomes')}</p>
                  <p class="resume-field-value">{exp.outcomes}</p>
                </div>
              </div>
              <div class="resume-entry-desc">
                <p class="resume-field-label">{t('resume.description')}</p>
                <p class="resume-field-value">{exp.description}</p>
              </div>
              <div class="resume-entry-footer">
                <p class="resume-entry-hint">{t('resume.scrollHint')}</p>
                <p class="resume-entry-year">© <span>{exp.timeframe}</span></p>
              </div>
            </article>
          ))}
        </div>
        <div class="resume-pagination-list">
          {experiences.map((exp, i) => (
            <button type="button" class:list={['resume-pagination-item', { active: i === 0 }]} data-index={i}>
              <span class="resume-pagination-item-label">{exp.company}</span>
              <span class="resume-pagination-item-thumb"></span>
              <span class="resume-pagination-item-progress-bg"><span class="resume-pagination-item-progress-fill"></span></span>
            </button>
          ))}
        </div>
        <div class="resume-controls">
          <button type="button" class="resume-arrow prev" aria-label={t('resume.prevAria')}>‹</button>
          <span class="resume-pagination-count"><span class="resume-current">01</span> / {pad(experiences.length - 1)}</span>
          <button type="button" class="resume-arrow next" aria-label={t('resume.nextAria')}>›</button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
