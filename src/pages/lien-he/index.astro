---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getLocale, localize as L } from '../../i18n/utils';
import { contact } from '../../data';

const locale = getLocale(Astro.url);
---

<BaseLayout
  title={L(contact.meta.title, locale)}
  description={L(contact.meta.description, locale)}
>
  <main class="page-main-wrapper">
    <section class="section contact reveal" id="contact">
      <div class="contact-card contact-card-form">
        <p class="eyebrow">{L(contact.eyebrow, locale)}</p>
        <h2>{L(contact.title, locale)}</h2>
        <p>{L(contact.text, locale)}</p>
        <ContactForm locale={locale} />
      </div>
    </section>
  </main>
</BaseLayout>
