---
// Standalone Liquid-Glass playground — NOT wired into the real site (no
// BaseLayout / global.css / site scripts). Visit /liquid-glass-demo/ under
// `npm run dev`. Demonstrates the SVG-displacement refraction technique
// (feTurbulence + feDisplacementMap driving backdrop-filter) with live sliders.
// Delete this page once you've decided whether to adopt it.
//
// ⚠ backdrop-filter: url(#filter) only works in Chromium (Chrome/Edge). Safari
// and Firefox ignore the url() part and fall back to plain blur — that's why
// the note in the corner exists.
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Liquid Glass — demo</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root { --blur: 4px; }
      body {
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #fff;
        overflow-x: hidden;
        /* Vibrant, high-contrast backdrop so the distortion is actually visible. */
        background: #14002b;
      }

      /* Animated colourful scene behind the glass — the more edges/contrast back
         here, the more obvious the refraction is. */
      .scene { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
      /* Sharp diagonal stripes — warping crisp high-contrast lines makes the
         refraction obvious (soft blobs alone barely show it). */
      .scene .stripes {
        position: absolute; inset: -20%;
        background: repeating-linear-gradient(48deg,
          rgba(255, 255, 255, 0.20) 0 12px, transparent 12px 40px);
        animation: float3 20s ease-in-out infinite;
      }
      .orb { position: absolute; border-radius: 50%; filter: blur(2px); opacity: 0.95; }
      .orb.a { width: 340px; height: 340px; background: radial-gradient(circle at 35% 30%, #ffd36e, #ff007b); top: 8%; left: 10%; animation: float1 14s ease-in-out infinite; }
      .orb.b { width: 300px; height: 300px; background: radial-gradient(circle at 30% 30%, #7af8ff, #6a0dad); top: 45%; left: 60%; animation: float2 17s ease-in-out infinite; }
      .orb.c { width: 260px; height: 260px; background: radial-gradient(circle at 40% 30%, #b6ff9e, #00d2ff); top: 62%; left: 18%; animation: float3 12s ease-in-out infinite; }
      .orb.d { width: 220px; height: 220px; background: radial-gradient(circle at 40% 30%, #ff9ce4, #ff2d55); top: 12%; left: 66%; animation: float1 16s ease-in-out infinite reverse; }
      .scene .grid {
        position: absolute; inset: -20%;
        background-image: linear-gradient(rgba(255,255,255,0.14) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255,255,255,0.14) 1px, transparent 1px);
        background-size: 46px 46px;
        transform: rotate(8deg);
      }
      @keyframes float1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(60px, 40px); } }
      @keyframes float2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-70px, 30px); } }
      @keyframes float3 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(40px, -50px); } }

      .stage {
        position: relative; z-index: 1;
        min-height: 100vh;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 40px; padding: 60px 20px;
      }

      /* ---- The Liquid Glass material ---- */
      .glass {
        /* Clearer glass: low tint + light blur, with saturate/brightness so the
           backdrop reads vivid through it rather than milky. The url() filter
           does the edge refraction. */
        background: rgba(255, 255, 255, 0.05);
        -webkit-backdrop-filter: blur(var(--blur)) saturate(1.6) brightness(1.06) url(#liquid-distortion);
        backdrop-filter: blur(var(--blur)) saturate(1.6) brightness(1.06) url(#liquid-distortion);
        /* Refractive rim: bright top-left / dark bottom-right border + inset
           highlights + a thin outer light ring make the edge visibly catch and
           bend light. */
        border-top: 1px solid rgba(255, 255, 255, 0.65);
        border-left: 1px solid rgba(255, 255, 255, 0.55);
        border-right: 1px solid rgba(255, 255, 255, 0.14);
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow:
          0 20px 40px rgba(0, 0, 0, 0.28),
          inset 0 1px 1px rgba(255, 255, 255, 0.55),
          inset 0 0 22px rgba(255, 255, 255, 0.1),
          inset 0 -2px 6px rgba(0, 0, 0, 0.18);
      }

      .glass-card {
        width: min(380px, 90vw);
        padding: 2.5rem;
        border-radius: 28px;
        text-align: center;
      }
      .glass-card h2 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 10px; }
      .glass-card p { opacity: 0.85; line-height: 1.6; }

      /* Nav pill built from the same material — the real use case. */
      .glass-nav {
        display: flex; align-items: center; gap: 6px;
        padding: 8px; border-radius: 999px;
      }
      .glass-nav a {
        padding: 10px 20px; border-radius: 999px; color: #fff; text-decoration: none;
        font-size: 0.95rem; font-weight: 500; opacity: 0.82; transition: opacity 0.2s, background 0.2s;
      }
      .glass-nav a:hover { opacity: 1; }
      .glass-nav a.on { background: rgba(255,255,255,0.22); opacity: 1; }

      /* ---- Controls ---- */
      .controls {
        position: fixed; top: 16px; right: 16px; z-index: 3;
        width: 260px; padding: 18px; border-radius: 18px;
        background: rgba(10, 8, 20, 0.72);
        -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.16);
        font-size: 0.85rem;
      }
      .controls h3 { font-size: 0.95rem; margin-bottom: 12px; }
      .ctl { margin-bottom: 14px; }
      .ctl label { display: flex; justify-content: space-between; margin-bottom: 6px; opacity: 0.85; }
      .ctl label b { color: #7af8ff; font-variant-numeric: tabular-nums; }
      .ctl input[type=range] { width: 100%; accent-color: #ff2d7b; }
      .note { margin-top: 6px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.14); opacity: 0.7; line-height: 1.5; }
      .note code { background: rgba(255,255,255,0.12); padding: 1px 5px; border-radius: 5px; }
      #support { margin-top: 8px; font-weight: 600; }
      #support.ok { color: #8dff9e; }
      #support.no { color: #ffb27a; }
    </style>
  </head>
  <body>
    <!-- Colourful animated scene -->
    <div class="scene">
      <div class="grid"></div>
      <div class="stripes"></div>
      <div class="orb a"></div>
      <div class="orb b"></div>
      <div class="orb c"></div>
      <div class="orb d"></div>
    </div>

    <div class="stage">
      <nav class="glass glass-nav">
        <a class="on">Giới thiệu</a>
        <a>Dịch vụ</a>
        <a>Dự án</a>
        <a>Liên hệ</a>
      </nav>

      <div class="glass glass-card">
        <h2>Liquid Glass</h2>
        <p>Kính lỏng kiểu Apple — nền phía sau bị bẻ cong, méo hữu cơ ở rìa qua bộ lọc nhiễu SVG.</p>
      </div>
    </div>

    <!-- The displacement filter. baseFrequency + scale are updated live by JS. -->
    <svg style="position:absolute;width:0;height:0" aria-hidden="true">
      <defs>
        <!-- Water-droplet refraction (not a flat sheet):
             1. blur the element SHAPE into a smooth height field — flat plateau
                in the middle, a curved slope around the rim (the meniscus),
             2. add a little organic noise so that rim ripples like liquid,
             3. displace the backdrop by that height. Because the value only
                *changes* around the rim, refraction concentrates at the edge
                while the centre stays clear — exactly like a real droplet.
             `curve` (the height blur) = how far the meniscus reaches inward. -->
        <filter id="liquid-distortion" x="-40%" y="-40%" width="180%" height="180%"
                color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceAlpha" stdDeviation="20" result="height" />
          <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="7" result="noise" />
          <feGaussianBlur in="noise" stdDeviation="1.2" result="softNoise" />
          <feComposite in="height" in2="softNoise" operator="arithmetic"
                       k1="0" k2="1" k3="0.15" k4="0" result="surface" />
          <feDisplacementMap in="SourceGraphic" in2="surface" scale="70"
                             xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <!-- Live controls -->
    <div class="controls">
      <h3>Liquid Glass — tinh chỉnh</h3>
      <div class="ctl">
        <label>scale (độ bẻ sáng) <b id="scaleOut">70</b></label>
        <input id="scale" type="range" min="0" max="200" step="1" value="70" />
      </div>
      <div class="ctl">
        <label>curve (độ cong rìa) <b id="curveOut">20</b></label>
        <input id="curve" type="range" min="4" max="60" step="1" value="20" />
      </div>
      <div class="ctl">
        <label>liquid (gợn nước) <b id="liquidOut">0.15</b></label>
        <input id="liquid" type="range" min="0" max="0.6" step="0.01" value="0.15" />
      </div>
      <div class="ctl">
        <label>blur (frost) <b id="blurOut">4px</b></label>
        <input id="blur" type="range" min="0" max="30" step="1" value="4" />
      </div>
      <div class="note">
        <div><code>curve</code> = mặt cong lan vào trong bao xa; <code>scale</code> = bẻ sáng mạnh cỡ nào; <code>liquid</code> = gợn nước ở rìa.</div>
        <div id="support"></div>
      </div>
    </div>

    <script>
      const disp = document.querySelector('#liquid-distortion feDisplacementMap');
      const heightBlur = document.querySelector('#liquid-distortion feGaussianBlur[in="SourceAlpha"]');
      const comp = document.querySelector('#liquid-distortion feComposite[operator="arithmetic"]');
      const root = document.documentElement;
      const $ = (id: string) => document.getElementById(id);

      const bind = (inputId: string, outId: string, fn: (v: number) => void, fmt?: (v: number) => string) => {
        const input = $(inputId) as HTMLInputElement | null;
        const out = $(outId);
        if (!input) return;
        const update = () => {
          const v = parseFloat(input.value);
          fn(v);
          if (out) out.textContent = fmt ? fmt(v) : String(v);
        };
        input.addEventListener('input', update);
        update();
      };

      bind('scale', 'scaleOut', (v) => disp && disp.setAttribute('scale', String(v)));
      bind('curve', 'curveOut', (v) => heightBlur && heightBlur.setAttribute('stdDeviation', String(v)));
      bind('liquid', 'liquidOut', (v) => comp && comp.setAttribute('k3', String(v)), (v) => v.toFixed(2));
      bind('blur', 'blurOut', (v) => root.style.setProperty('--blur', v + 'px'), (v) => v + 'px');

      // Detect whether this browser honours url() inside backdrop-filter (Chromium
      // does; Safari/Firefox don't → they only show plain blur, no warping).
      const supportEl = $('support');
      const supported = CSS && CSS.supports &&
        (CSS.supports('backdrop-filter', 'url(#x)') || CSS.supports('-webkit-backdrop-filter', 'url(#x)'));
      if (supportEl) {
        if (supported) { supportEl.textContent = '✓ Trình duyệt này hỗ trợ refraction (Chromium).'; supportEl.className = 'ok'; }
        else { supportEl.textContent = '⚠ Trình duyệt này KHÔNG hỗ trợ url() trong backdrop-filter — chỉ thấy blur, không méo. Thử Chrome/Edge.'; supportEl.className = 'no'; }
      }
    </script>
  </body>
</html>
