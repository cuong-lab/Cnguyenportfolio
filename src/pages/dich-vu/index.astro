---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getLocale, localize as L } from '../../i18n/utils';
import { services } from '../../data';
import { getServices } from '../../sanity/api.js';

const locale = getLocale(Astro.url);
const servicesList = await getServices();
---

<BaseLayout
  title={L(services.meta.title, locale)}
  description={L(services.meta.description, locale)}
>
  <main>
    <section class="section services reveal">
      <div class="section-heading">
        <p class="eyebrow">{L(services.eyebrow, locale)}</p>
        <h2>{L(services.heading, locale)}</h2>
      </div>
      <div class="service-grid reveal-stagger">
        {servicesList.map((service) => (
          <ServiceCard title={service.title} description={service.description} iconUrl={service.iconUrl} />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
