---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectModal from '../../components/ProjectModal.astro';
import { getLocale, useTranslations, localize as L } from '../../i18n/utils';
import { projects } from '../../data';
import { getProjects, getProjectsGroupedByCategory, getPortfolioPage } from '../../sanity/api.js';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const [projectList, portfolioPage] = await Promise.all([
  getProjects(),
  getPortfolioPage(),
]);
const categoryGroups = await getProjectsGroupedByCategory(projectList);

const allCategories = categoryGroups.map((g) => g.name);
---

<BaseLayout
  title={L(projects.meta.title, locale)}
  description={L(projects.meta.description, locale)}
>
  <main class="page-main-wrapper">
    <div class="editorial-container">
      <section class="section portfolio reveal">
        <div class="editorial-header">
          <div class="section-tag">{portfolioPage.eyebrow}</div>
          <h1 class="editorial-title">{portfolioPage.heading}</h1>
          {portfolioPage.description && (
            <p class="editorial-description">{portfolioPage.description}</p>
          )}
        </div>

        {allCategories.length > 0 && (
          <div class="portfolio-filter" role="group" aria-label={t('project.filterAria')}>
            <button type="button" class="filter-pill active" data-filter="all">{t('project.all')}</button>
            {allCategories.map((cat) => (
              <button type="button" class="filter-pill" data-filter={cat}>{cat}</button>
            ))}
          </div>
        )}

        <div class="portfolio-category-sections" data-portfolio-sections>
          {categoryGroups.map((group) => {
            const isReelGroup = group.name.toLowerCase().includes('reel');
            return (
            <div class="category-group-block" data-category-group={group.name}>
              <div class="category-group-header">
                <h2 class="category-group-title">[ {group.name.toUpperCase()} ]</h2>
                <div class="category-header-right">
                  {isReelGroup && (
                    <div class="reel-slider-nav">
                      <button type="button" class="reel-btn reel-prev" aria-label="Previous">&lsaquo;</button>
                      <button type="button" class="reel-btn reel-next" aria-label="Next">&rsaquo;</button>
                    </div>
                  )}
                  <span class="category-group-count">{group.projects.length} dự án</span>
                </div>
              </div>
              <div class={isReelGroup ? "portfolio-reel-slider reveal-stagger" : "portfolio-grid reveal-stagger"} data-portfolio-grid={!isReelGroup ? "" : null} data-reel-slider={isReelGroup ? "" : null}>
                {group.projects.map((project) => {
                  const globalIndex = projectList.findIndex((p) => p.id === project.id);
                  return (
                    <ProjectCard
                      title={project.title}
                      index={globalIndex !== -1 ? globalIndex : 0}
                      coverImageUrl={project.coverImageUrl}
                      videoHoverUrl={project.videoHoverUrl}
                      cardClass={project.cardClass}
                      categories={project.categories}
                      id={project.id}
                      aspectRatio={project.aspectRatio}
                    />
                  );
                })}
              </div>
            </div>
          )})}
        </div>
      </section>
      
      <ProjectModal projects={projectList} />
    </div>
  </main>

  <script>
    import '../../scripts/portfolio-filter.js';
  </script>
</BaseLayout>
