---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { getLocale, useTranslations, localize as L } from '../i18n/utils';
import { home, contact } from '../data';
import { getServices, getProjects, getSiteSettings } from '../sanity/api.js';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { hero, servicesTeaser, portfolioTeaser } = home;

// Sanity-backed (with src/data fallback)
const [servicesList, allProjects, settings] = await Promise.all([
  getServices(),
  getProjects(),
  getSiteSettings(),
]);

const featuredProjects = allProjects.slice(0, 8);

// Dynamic Hero values from Sanity site_settings (falling back to static home.json)
const heroEyebrow = settings.hero?.eyebrow || L(hero.eyebrow, locale);
const heroTitle = settings.hero?.title || L(hero.title, locale);
const heroText = settings.hero?.description || L(hero.text, locale);
const heroVideoUrl = settings.hero?.videoUrl || "/videos/showreel-preview.mp4";
const heroPoster = settings.hero?.posterImageUrl || "/images/hero-poster.jpg";

// Auto-detect YouTube URL and convert to embed format
function getYouTubeEmbedUrl(url: string | null): string | null {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  if (match && match[1]) {
    const videoId = match[1];
    return `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${videoId}&playsinline=1&modestbranding=1&rel=0`;
  }
  return null;
}

const youtubeEmbedUrl = getYouTubeEmbedUrl(heroVideoUrl);
---

<BaseLayout
  title={settings.seoTitle || L(home.meta.title, locale)}
  description={settings.metaDescription || L(home.meta.description, locale)}
>
  <main id="hero">
    <!-- Cinematic Hero (Netflix Style Bottom-Left) -->
    <section class="hero cinematic-hero">
      <div class="cinematic-bg">
        {youtubeEmbedUrl ? (
          <iframe
            class="cinematic-video youtube-hero-iframe"
            src={youtubeEmbedUrl}
            title="Hero Background Video"
            allow="autoplay; encrypted-media"
            frameborder="0"
          ></iframe>
        ) : (
          <video autoplay loop muted playsinline class="cinematic-video" poster={heroPoster}>
            <source src={heroVideoUrl} type="video/mp4" />
          </video>
        )}
        <div class="cinematic-overlay"></div>
      </div>
      
      <div class="hero-content reveal">
        <p class="eyebrow cinematic-eyebrow">{heroEyebrow}</p>
        <h1 class="cinematic-title">{heroTitle}</h1>
        <p class="hero-text cinematic-text">{heroText}</p>
        <div class="hero-actions">
          <a class="button primary" href="/portfolio/">{t('actions.viewProjects')}</a>
          <a class="button ghost light" href="/lien-he/">{t('actions.contactNow')}</a>
        </div>
      </div>
    </section>

    <!-- Section 01: Featured Portfolio with 100% Transform-Based Silky Slider -->
    <section id="portfolio" class="section editorial-section reveal">
      <div class="editorial-container">
        <div class="editorial-header">
          <div class="section-tag">{settings.portfolioTeaser.tag}</div>
          <h2 class="editorial-title">{settings.portfolioTeaser.title || L(portfolioTeaser.heading, locale)}</h2>
        </div>
        
        <div class="portfolio-slider-wrapper">
          <button type="button" id="port-prev" class="slider-arrow-btn arrow-prev" aria-label="Previous Project">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>

          <div class="portfolio-slider-viewport" id="portfolio-viewport">
            <div class="portfolio-slider-track" id="portfolio-track">
              {featuredProjects.map((project, i) => (
                <ProjectCard
                  title={project.title}
                  index={i}
                  coverImageUrl={project.coverImageUrl}
                  videoHoverUrl={project.videoHoverUrl}
                  cardClass={project.cardClass}
                  id={project.id}
                />
              ))}
            </div>
          </div>

          <button type="button" id="port-next" class="slider-arrow-btn arrow-next" aria-label="Next Project">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
        
        <div class="editorial-action">
          <a class="button ghost" href="/portfolio/">{t('actions.viewAllProjects')} ↗</a>
        </div>
      </div>
    </section>

    <!-- Stats Counter Section -->
    <section class="section stats-counter-section reveal">
      <div class="editorial-container">
        <div class="stats-counter-bar">
          <div class="stat-counter-item">
            <span class="stat-num" data-target={settings.stats.stat1_value} data-prefix={settings.stats.stat1_prefix} data-suffix={settings.stats.stat1_suffix}>0</span>
            <span class="stat-lbl">{settings.stats.stat1_label}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-counter-item">
            <span class="stat-num" data-target={settings.stats.stat2_value} data-suffix={settings.stats.stat2_suffix}>0</span>
            <span class="stat-lbl">{settings.stats.stat2_label}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-counter-item">
            <span class="stat-num" data-target={settings.stats.stat3_value}>0</span>
            <span class="stat-lbl">{settings.stats.stat3_label}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 02: Services & Capabilities -->
    <section id="services" class="section editorial-section reveal">
      <div class="editorial-container">
        <div class="editorial-header">
          <div class="section-tag">{settings.servicesTeaser.tag}</div>
          <h2 class="editorial-title">{settings.servicesTeaser.title || L(servicesTeaser.heading, locale)}</h2>
        </div>
        
        <div class="service-grid reveal-stagger">
          {servicesList.map((service) => (
            <ServiceCard title={service.title} description={service.description} iconUrl={service.iconUrl} />
          ))}
        </div>
        
        <div class="editorial-action">
          <a class="button ghost" href="/dich-vu/">{t('actions.viewServices')} ↗</a>
        </div>
      </div>
    </section>

    <!-- In-Page Lightbox Modal -->
    <ProjectModal projects={featuredProjects} />

    <!-- Section 03: Contact Banner -->
    <section class="section editorial-contact-section reveal" id="contact">
      <div class="editorial-container">
        <div class="contact-banner-inner">
          <div class="section-tag">{settings.contactBanner.tag}</div>
          <h2 class="contact-banner-title">{settings.contactBanner.title || L(contact.title, locale)}</h2>
          <p class="contact-banner-text">{settings.contactBanner.text || L(contact.text, locale)}</p>
          <div class="contact-banner-action">
            <a class="button primary" href="/lien-he/">{t('actions.contactNow')}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    // 100% Transform-Based Hardware-Accelerated Smooth Slider < >
    const track = document.getElementById('portfolio-track');
    const viewport = document.getElementById('portfolio-viewport');
    const prevBtn = document.getElementById('port-prev');
    const nextBtn = document.getElementById('port-next');

    if (track && viewport && prevBtn && nextBtn) {
      let currentOffset = 0;
      const stepWidth = 380; // card width (360) + gap (20)

      const getMaxOffset = () => {
        return Math.max(0, track.scrollWidth - viewport.clientWidth);
      };

      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        currentOffset = Math.max(0, currentOffset - stepWidth);
        track.style.transform = `translateX(-${currentOffset}px)`;
      });

      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const maxOffset = getMaxOffset();
        currentOffset = Math.min(maxOffset, currentOffset + stepWidth);
        track.style.transform = `translateX(-${currentOffset}px)`;
      });
    }

    // CountUp Animation for Stats
    const counterItems = document.querySelectorAll('.stat-num');
    if (counterItems.length) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.getAttribute('data-target') || '0', 10);
            const prefix = el.getAttribute('data-prefix') || '';
            const suffix = el.getAttribute('data-suffix') || '';
            let count = 0;
            const duration = 1400;
            const stepTime = 20;
            const steps = duration / stepTime;
            const increment = target / steps;

            const timer = setInterval(() => {
              count += increment;
              if (count >= target) {
                count = target;
                clearInterval(timer);
              }
              el.textContent = `${prefix}${Math.floor(count)}${suffix}`;
            }, stepTime);

            observer.unobserve(el);
          }
        });
      }, { threshold: 0.4 });

      counterItems.forEach(item => observer.observe(item));
    }
  </script>
</BaseLayout>
