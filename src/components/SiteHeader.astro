---
interface Props {
  page: 'home' | 'resume';
}
const { page } = Astro.props;
const isHome = page === 'home';
const base = isHome ? '' : '/';
const introHref = isHome ? '#intro' : '#about-me';
const resumeHref = isHome ? '/resume/#resume-experience' : '#resume-experience';
const logoHref = `${base}#hero`;
---

<header class="site-header">
  <a id="logo" class="brand" href={logoHref}>Cường Nguyễn Showreel</a>
  <nav class="nav-pill-wrapper" aria-label="Điều hướng chính">
    <div class="nav-indicator-glow"></div>
    <div class="nav-pill">
      <div class="nav-indicator-pill"></div>
      <a href={introHref} class="nav-toggle">Giới thiệu</a>
      <a href={`${base}#services`} class="nav-toggle">Dịch vụ</a>
      <a href={`${base}#portfolio`} class="nav-toggle">Dự án</a>
      <a href={`${base}#contact`} class="nav-toggle">Liên hệ</a>
    </div>
  </nav>
  <div class="header-actions">
    <a class="nav-link-plain" href={resumeHref}>Resume</a>
    <a class="nav-cta" href={`${base}#contact`}>Đặt lịch</a>
  </div>
</header>
