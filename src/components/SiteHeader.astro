---
// Per project routing rule: every nav link is a real /path/ route — no #hash
// anchor stands in for a page. The active tab is resolved server-side here from
// Astro.url.pathname (not in the browser) so the correct pill renders in the
// initial HTML — that removes the flash where the indicator started on "Home"
// and visibly slid to the real tab after hydration (site.js then just positions
// the indicator under whichever toggle already carries .active).
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const navItems = [
  { key: 'about', href: '/' },
  { key: 'work', href: '/portfolio/' },
  { key: 'resume', href: '/resume/' },
  { key: 'services', href: '/dich-vu/' },
  { key: 'contact', href: '/lien-he/' },
] as const;

const normalize = (path: string) => path.replace(/index\.html$/, '').replace(/\/$/, '') || '/';
const current = normalize(Astro.url.pathname);
const isActive = (href: string) => normalize(href) === current;
---

<header class="site-header">
  <a id="logo" class="brand" href="/">Cường Nguyễn Showreel</a>
  <nav class="nav-pill-wrapper" aria-label={t('nav.ariaLabel')}>
    <div class="nav-indicator-glow"></div>
    <div class="nav-pill">
      <div class="nav-indicator-pill"></div>
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-toggle', { active: isActive(item.href) }]}
        >
          {t(`nav.${item.key}`)}
        </a>
      ))}
    </div>
  </nav>
  <div class="header-actions">
    <a class="nav-cta" href="/lien-he/">{t('actions.bookNow')}</a>
  </div>
</header>
