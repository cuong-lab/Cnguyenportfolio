---
interface Props {
  mediaAdmin?: boolean;
}
const { mediaAdmin = false } = Astro.props;
---

<div id="admin-bar" class="admin-bar" aria-hidden="true">
  <div class="admin-inner">
    <span id="admin-status">Admin: off</span>
    <button type="button" id="admin-save" class="button primary small">Lưu</button>
    {mediaAdmin && (
      <button type="button" id="media-admin-btn" class="button ghost small">Quản lý ảnh/video</button>
    )}
    {mediaAdmin && (
      <button type="button" id="admin-signout" class="button ghost small">Đăng xuất</button>
    )}
    <button type="button" id="admin-exit" class="button ghost small">Thoát</button>
  </div>
</div>

{mediaAdmin && (
  <div id="admin-login" class="admin-login" hidden aria-hidden="true">
    <form id="admin-login-form">
      <input type="email" id="admin-login-email" placeholder="Email" required autocomplete="username" />
      <input type="password" id="admin-login-password" placeholder="Mật khẩu" required autocomplete="current-password" />
      <button type="submit" class="button primary small">Đăng nhập</button>
      <p id="admin-login-error" class="admin-login-error" hidden></p>
    </form>
  </div>
)}
