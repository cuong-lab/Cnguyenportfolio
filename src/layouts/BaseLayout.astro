---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeavyAnimationLoader from '../components/HeavyAnimationLoader.astro';
import LoadingOverlay from '../components/LoadingOverlay.astro';
import { getLocale, useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  initFn?: 'initExplore' | 'initResume';
  mediaGallery?: boolean;
  ogImage?: string;
}
const { title, description, initFn, mediaGallery = false, ogImage = '/images/og-default.jpg' } = Astro.props;

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);
const resolvedOgImage = new URL(ogImage, Astro.site || Astro.url).toString();
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {initFn && <HeavyAnimationLoader initFn={initFn} />}
    {mediaGallery && (
      <script>
        import '../scripts/gallery.js';
      </script>
    )}
  </head>
  <body>
    <div class="film-grain-overlay" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>

    <SiteHeader />

    <slot />
    
    <LoadingOverlay />

    <SiteFooter />

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
