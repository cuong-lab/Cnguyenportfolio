---
import SiteHeader from '../components/SiteHeader.astro';
import AdminBar from '../components/AdminBar.astro';
import HeavyAnimationLoader from '../components/HeavyAnimationLoader.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  initFn?: 'initExplore' | 'initResume';
  mediaGallery?: boolean;
}
const { title, description, initFn, mediaGallery = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    {initFn && <HeavyAnimationLoader initFn={initFn} />}
    {mediaGallery && (
      <script>
        import '../scripts/gallery.js';
      </script>
    )}
  </head>
  <body>
    <div class="background-glow glow-1"></div>
    <div class="background-glow glow-2"></div>

    <SiteHeader />
    <AdminBar mediaAdmin={mediaGallery} />

    <slot />

    <footer class="site-footer">
      <p>© <span id="year"></span> Cường Nguyễn Showreel. Crafted with light and story.</p>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
